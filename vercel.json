  "name": "dentalcare-pro-erp",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/supabase-api/:path*",
      "destination": "https://vvukhdpunflbuqhsohhf.supabase.co/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
